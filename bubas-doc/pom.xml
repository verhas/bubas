        </dependency>
        <dependency>
            <groupId>com.javax0.bubas</groupId>
            <artifactId>bubas-bunit-standard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.javax0.bubas</groupId>
            <artifactId>bubas-export</artifactId>
            <version>${project.version}</version>
