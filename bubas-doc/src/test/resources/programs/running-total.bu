PROGRAM RunningTotal(claim Report, limit DECIMAL) RETURNS BOOLEAN
    DECLARE i INTEGER
    DECLARE line Item
    DECLARE running DECIMAL

    running = 0.0
    i = 1

    DO WHILE i <= ITEM_COUNT(claim) AND running <= limit
        line = ITEM_AT(claim, i)
        running = running + AMOUNT_OF(line)
        i = i + 1
    END DO

    IF running > limit THEN
        ESCALATE claim, "passed the limit at line " + (i - 1)
        RETURN FALSE
    END IF

    APPROVE claim
    RETURN TRUE
END.
