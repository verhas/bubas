'OK
' A loop body may run any number of times, so what it writes is unknown inside the loop, in the
' condition, and after it — even where a straight line would have settled the value.
' The limit is deliberately an ordinary literal: it is not written in the body, so it stays
' settled. What makes the condition a real question is 'n', and only 'n'.
PROGRAM P
    DECLARE n INTEGER
    DECLARE limit INTEGER
    n = 5
    limit = 7
    DO WHILE n < limit
        n = n + 1
    END DO
    IF n = 7 THEN
        ASSERT "the loop counted up to the limit", TRUE
    END IF
END.
