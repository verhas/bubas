'NO-COMPILE
' The variable is not constant — it is assigned again below — but where the condition reads it
' it holds 5, so the condition has an answer before the program runs.
' ERROR: always FALSE
' LINE: 9
PROGRAM P
    DECLARE n INTEGER
    n = 5
    IF n > 10 THEN
        n = 1
    END IF
    ASSERT "unreachable", n = 1
END.
