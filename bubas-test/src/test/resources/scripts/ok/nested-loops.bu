'OK
' EXIT leaves the innermost loop of its kind and no more.
PROGRAM P
    DECLARE i INTEGER
    DECLARE j INTEGER
    DECLARE total INTEGER
    total = 0
    FOR i = 1 TO 3
        FOR j = 1 TO 10
            IF j > 2 THEN
                EXIT FOR
            END IF
            total = total + 1
        END FOR
    END FOR
    ASSERT "the outer loop kept running", total = 6
END.
