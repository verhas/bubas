'OK
' Ascending, descending, STEP, a loop that never runs, and EXIT FOR.
PROGRAM P
    DECLARE i INTEGER
    DECLARE total INTEGER
    DECLARE past INTEGER
    DECLARE behind INTEGER
    total = 0
    FOR i = 1 TO 4
        total = total + i
    END FOR
    ASSERT "the bounds are inclusive", total = 10
    total = 0
    FOR i = 10 TO 0 STEP -2
        total = total + 1
    END FOR
    ASSERT "a negative step counts down", total = 6
    total = 0
    FOR i = 0 TO 9 STEP 3
        total = total + i
    END FOR
    ASSERT "a step may overshoot the end", total = 18
    past = MIRROR(5)
    behind = MIRROR(1)
    total = 0
    FOR i = past TO behind
        total = total + 1
    END FOR
    ASSERT "a loop whose start is past its end never runs", total = 0
    total = 0
    FOR i = 1 TO 100
        IF i > 3 THEN
            EXIT FOR
        END IF
        total = total + i
    END FOR
    ASSERT "EXIT FOR", total = 6
END.
